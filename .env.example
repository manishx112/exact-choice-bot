# Tera Apps Script web-app URL (catalog JSON). Asli URL yahan commit mat karna —
# isse poora catalog (Group A bhi) koi bhi khol sakta hai.
# Comma se backup URL bhi de sakte ho: pehla fail (404 / timeout) toh doosra.
APPS_SCRIPT_URL=https://script.google.com/macros/s/PRIMARY_DEPLOYMENT_ID/exec,https://script.google.com/macros/s/BACKUP_DEPLOYMENT_ID/exec

# Reply ko human banane ke liye. Dono khaali chhoda toh deterministic draft
# hi jaayega (bot phir bhi poora chalta hai).
# ⚠️ NEXT_PUBLIC_ mat lagana — ye server-only rehni chahiye

# Groq = aakhri sahara. Gemini ka koi model na chale tabhi ye chalta hai.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Image strategy: "public" (Drive public link) ya "proxy" (Apps Script blob)
NEXT_PUBLIC_IMG_MODE=proxy

# Gemini pehle try hota hai (aistudio.google.com → API Keys, free tier).
# GEMINI_MODELS = comma se alag ki hui list, order hi priority hai: pehla model
# fail (404 band / 429 quota / 503 busy / 3 sec me jawaab nahi) toh doosra, phir
# Groq. Fail hua model 404 par restart tak, 429 par 60 sec skip. "-latest" naam
# mat daalna — flash-lite-latest asal me 3.5-flash-lite hai, quota bhi wahi.
# Model "flash-lite" hi rakho — bade/thinking model 8-12 sec lete hain aur reply
# beech me kaat dete hain. 1.5 / 2.0 / 2.5 wale sab band ho chuke hain (404).
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
